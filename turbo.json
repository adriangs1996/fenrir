{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "FENRIR_LOG_WS_EVENTS",
    "FENRIR_MODE",
    "FENRIR_PORT",
    "FENRIR_NO_BROWSER",
    "FENRIR_HOME",
    "FENRIR_AUTH_TOKEN",
    "FENRIR_DESKTOP_WS_URL",
    "FENRIR_TRACE_MIN_LEVEL",
    "FENRIR_TRACE_TIMING_ENABLED",
    "FENRIR_TRACE_FILE",
    "FENRIR_TRACE_MAX_BYTES",
    "FENRIR_TRACE_MAX_FILES",
    "FENRIR_TRACE_BATCH_WINDOW_MS",
    "FENRIR_OTLP_TRACES_URL",
    "FENRIR_OTLP_METRICS_URL",
    "FENRIR_OTLP_EXPORT_INTERVAL_MS",
    "FENRIR_OTLP_SERVICE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["@fenrir/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
