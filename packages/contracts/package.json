{
  "name": "@fenrir/contracts",
  "version": "0.0.15",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./sourceControlReview": {
      "types": "./src/sourceControlReview.ts",
      "import": "./src/sourceControlReview.ts",
      "require": "./src/sourceControlReview.ts"
    },
    "./sourceControl": {
      "types": "./src/sourceControl.ts",
      "import": "./src/sourceControl.ts",
      "require": "./src/sourceControl.ts"
    },
    "./vcs": {
      "types": "./src/vcs.ts",
      "import": "./src/vcs.ts",
      "require": "./src/vcs.ts"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "require": "./src/settings.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format esm,cjs --dts --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
